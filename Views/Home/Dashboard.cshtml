@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h2 fw-bold">
            <i class="bi bi-speedometer2"></i> Dashboard Overview
        </h1>
        <p class="text-muted">Welcome back, @User.Identity.Name!</p>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm dashboard-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1 fw-semibold">Total Rooms</h6>
                        <h2 class="mb-0 fw-bold text-primary">@ViewBag.TotalRooms</h2>
                    </div>
                    <div class="stat-icon bg-primary bg-opacity-10">
                        <i class="bi bi-door-open text-primary" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm dashboard-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1 fw-semibold">Available</h6>
                        <h2 class="mb-0 fw-bold text-success">@ViewBag.AvailableRooms</h2>
                    </div>
                    <div class="stat-icon bg-success bg-opacity-10">
                        <i class="bi bi-check-circle text-success" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm dashboard-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1 fw-semibold">Occupied</h6>
                        <h2 class="mb-0 fw-bold text-danger">@ViewBag.OccupiedRooms</h2>
                    </div>
                    <div class="stat-icon bg-danger bg-opacity-10">
                        <i class="bi bi-door-closed text-danger" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm dashboard-card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted mb-1 fw-semibold">Active Bookings</h6>
                        <h2 class="mb-0 fw-bold text-info">@ViewBag.ActiveBookings</h2>
                    </div>
                    <div class="stat-icon bg-info bg-opacity-10">
                        <i class="bi bi-calendar-check text-info" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Today's Activity -->
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="stat-icon bg-primary bg-opacity-10 me-3">
                        <i class="bi bi-calendar-event text-primary" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0 fw-semibold">Today's Check-ins</h6>
                        <h3 class="mb-0 fw-bold text-primary">@ViewBag.TodayCheckIns</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="stat-icon bg-warning bg-opacity-10 me-3">
                        <i class="bi bi-calendar-x text-warning" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <h6 class="text-muted mb-0 fw-semibold">Today's Check-outs</h6>
                        <h3 class="mb-0 fw-bold text-warning">@ViewBag.TodayCheckOuts</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Bookings -->
<div class="row">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history"></i> Recent Bookings</h5>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.RecentBookings != null && ViewBag.RecentBookings.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Booking #</th>
                                    <th>Guest Name</th>
                                    <th>Room</th>
                                    <th>Check-in</th>
                                    <th>Check-out</th>
                                    <th>Status</th>
                                    <th>Amount</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var booking in ViewBag.RecentBookings)
                                {
                                    <tr>
                                        <td class="fw-semibold">@booking.BookingNumber</td>
                                        <td>@booking.GuestName</td>
                                        <td>Room @booking.Room.RoomNumber</td>
                                        <td>@booking.CheckInDate.ToString("MMM dd, yyyy")</td>
                                        <td>@booking.CheckOutDate.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            @if (booking.Status == HotelManagementSystem2.Models.BookingStatus.Confirmed)
                                            {
                                                <span class="badge bg-success">Confirmed</span>
                                            }
                                            else if (booking.Status == HotelManagementSystem2.Models.BookingStatus.CheckedIn)
                                            {
                                                <span class="badge bg-primary">Checked In</span>
                                            }
                                            else if (booking.Status == HotelManagementSystem2.Models.BookingStatus.CheckedOut)
                                            {
                                                <span class="badge bg-secondary">Checked Out</span>
                                            }
                                            else if (booking.Status == HotelManagementSystem2.Models.BookingStatus.Cancelled)
                                            {
                                                <span class="badge bg-danger">Cancelled</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning">Pending</span>
                                            }
                                        </td>
                                        <td class="fw-bold">&#8369;@booking.TotalAmount.ToString("N2")</td>
                                        <td>
                                            <a asp-controller="Bookings" asp-action="Details" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-primary">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                        <p class="mt-3">No recent bookings</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
