@model HotelManagementSystem2.Models.ViewModels.UserViewModel

@{
    ViewData["Title"] = "User Details";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 fw-bold"><i class="bi bi-person-circle"></i> User Details</h1>
        <p class="text-muted">View user information</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-info-circle"></i> User Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Full Name:</strong>
                        <p class="text-muted">@Model.FullName</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Email:</strong>
                        <p class="text-muted">
                            @Model.Email
                            @if (Model.EmailConfirmed)
                            {
                                <span class="badge bg-success ms-2">
                                    <i class="bi bi-check-circle"></i> Confirmed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning ms-2">
                                    <i class="bi bi-x-circle"></i> Not Confirmed
                                </span>
                            }
                        </p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Phone Number:</strong>
                        <p class="text-muted">@Model.PhoneNumber</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Status:</strong>
                        <p>
                            @if (Model.IsLocked)
                            {
                                <span class="badge bg-danger">
                                    <i class="bi bi-lock"></i> Locked
                                </span>
                                <br />
                                <small class="text-muted">Until: @Model.LockoutEnd?.ToString("MMM dd, yyyy")</small>
                            }
                            else
                            {
                                <span class="badge bg-success">
                                    <i class="bi bi-unlock"></i> Active
                                </span>
                            }
                        </p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <strong>Role(s):</strong>
                        <p>
                            @foreach (var role in Model.Roles)
                            {
                                @if (role == "Admin")
                                {
                                    <span class="badge bg-danger me-1">@role</span>
                                }
                                else if (role == "Guest")
                                {
                                    <span class="badge bg-info me-1">@role</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary me-1">@role</span>
                                }
                            }
                        </p>
                    </div>
                </div>

                <hr>

                <div class="d-flex gap-2 flex-wrap">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Edit User
                    </a>
                    <a asp-action="ChangePassword" asp-route-id="@Model.Id" class="btn btn-secondary">
                        <i class="bi bi-key"></i> Change Password
                    </a>
                    @if (Model.IsLocked)
                    {
                        <form asp-action="UnlockUser" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success" onclick="return confirm('Unlock this user?')">
                                <i class="bi bi-unlock"></i> Unlock User
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="LockUser" asp-route-id="@Model.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-warning" onclick="return confirm('Lock this user?')">
                                <i class="bi bi-lock"></i> Lock User
                            </button>
                        </form>
                    }
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Delete User
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-info mb-3">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="bi bi-lightbulb"></i> Role Permissions</h6>
            </div>
            <div class="card-body">
                @if (Model.Roles.Contains("Admin"))
                {
                    <h6 class="fw-bold text-danger">Admin Permissions:</h6>
                    <ul class="small">
                        <li>Full system access</li>
                        <li>Manage all bookings</li>
                        <li>Manage all rooms</li>
                        <li>Manage users</li>
                        <li>View dashboard & reports</li>
                    </ul>
                }
                else if (Model.Roles.Contains("Guest"))
                {
                    <h6 class="fw-bold text-info">Guest Permissions:</h6>
                    <ul class="small">
                        <li>Book rooms</li>
                        <li>View own bookings</li>
                        <li>Cancel own bookings</li>
                        <li>Update profile</li>
                    </ul>
                }
            </div>
        </div>

        <div class="card border-warning">
            <div class="card-header bg-warning">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Account Status</h6>
            </div>
            <div class="card-body">
                <p class="small mb-2">
                    <strong>User ID:</strong><br />
                    <code>@Model.Id</code>
                </p>
                <p class="small mb-0">
                    <strong>Email Status:</strong><br />
                    @if (Model.EmailConfirmed)
                    {
                        <span class="text-success">? Verified</span>
                    }
                    else
                    {
                        <span class="text-warning">? Not Verified</span>
                    }
                </p>
            </div>
        </div>
    </div>
</div>
