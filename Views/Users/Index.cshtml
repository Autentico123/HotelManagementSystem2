@model IEnumerable<HotelManagementSystem2.Models.ViewModels.UserViewModel>

@{
    ViewData["Title"] = "User Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 fw-bold"><i class="bi bi-people"></i> User Management</h1>
        <p class="text-muted">Manage system users and their roles</p>
    </div>
    <a asp-controller="Account" asp-action="Register" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Add New User
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role(s)</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                <i class="bi bi-person-circle text-primary"></i> @user.FullName
                            </td>
                            <td>
                                @if (user.EmailConfirmed)
                                {
                                    <i class="bi bi-check-circle text-success" title="Email Confirmed"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle text-warning" title="Email Not Confirmed"></i>
                                }
                                @user.Email
                            </td>
                            <td>@user.PhoneNumber</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    @if (role == "Admin")
                                    {
                                        <span class="badge bg-danger me-1">@role</span>
                                    }
                                    else if (role == "Guest")
                                    {
                                        <span class="badge bg-info me-1">@role</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary me-1">@role</span>
                                    }
                                }
                            </td>
                            <td>
                                @if (user.IsLocked)
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-lock"></i> Locked
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-unlock"></i> Active
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="@user.Id" class="btn btn-sm btn-info" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning" title="Edit User">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="ChangePassword" asp-route-id="@user.Id" class="btn btn-sm btn-secondary" title="Change Password">
                                        <i class="bi bi-key"></i>
                                    </a>
                                    @if (user.IsLocked)
                                    {
                                        <form asp-action="UnlockUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-success" title="Unlock User" onclick="return confirm('Unlock this user?')">
                                                <i class="bi bi-unlock"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="LockUser" asp-route-id="@user.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-warning" title="Lock User" onclick="return confirm('Lock this user?')">
                                                <i class="bi bi-lock"></i>
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger" title="Delete User">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card border-info">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-info-circle text-info"></i> User Roles</h6>
                <ul class="small mb-0">
                    <li><span class="badge bg-danger">Admin</span> - Full system access</li>
                    <li><span class="badge bg-info">Guest</span> - Can book and view own bookings</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-success">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-shield-check text-success"></i> User Status</h6>
                <ul class="small mb-0">
                    <li><span class="badge bg-success">Active</span> - Can login normally</li>
                    <li><span class="badge bg-danger">Locked</span> - Cannot login</li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-warning">
            <div class="card-body">
                <h6 class="card-title"><i class="bi bi-lightning text-warning"></i> Quick Actions</h6>
                <ul class="small mb-0">
                    <li><i class="bi bi-eye"></i> View - See user details</li>
                    <li><i class="bi bi-pencil"></i> Edit - Update user info</li>
                    <li><i class="bi bi-key"></i> Password - Reset password</li>
                    <li><i class="bi bi-lock/unlock"></i> Lock/Unlock - Control access</li>
                    <li><i class="bi bi-trash"></i> Delete - Remove user</li>
                </ul>
            </div>
        </div>
    </div>
</div>
