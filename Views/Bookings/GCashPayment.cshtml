@model HotelManagementSystem2.Models.ViewModels.GCashPaymentViewModel

@{
    ViewData["Title"] = "GCash Payment";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="mb-4">
                <a asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary mb-3">
                    <i class="bi bi-arrow-left"></i> Back to Booking
                </a>
                <h2 class="fw-bold">
                    <i class="bi bi-phone text-primary"></i> GCash Payment
                </h2>
                <p class="text-muted">Pay securely using your GCash mobile wallet</p>
            </div>

            <div class="row g-4">
                <!-- Payment Form -->
                <div class="col-md-7">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-credit-card-2-front me-2"></i>
                                Payment Details
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <form asp-action="GCashPayment" method="post">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                                
                                <input asp-for="BookingId" type="hidden" />

                                <!-- Booking Info Display -->
                                <div class="alert alert-info border-0 mb-4">
                                    <div class="d-flex align-items-start">
                                        <i class="bi bi-info-circle me-2 fs-5"></i>
                                        <div>
                                            <strong>Booking:</strong> @Model.BookingNumber<br>
                                            <strong>Guest:</strong> @Model.GuestName
                                        </div>
                                    </div>
                                </div>

                                <!-- GCash Mobile Number -->
                                <div class="mb-4">
                                    <label asp-for="GCashNumber" class="form-label fw-semibold">
                                        <i class="bi bi-phone-fill text-primary me-1"></i> GCash Mobile Number *
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-phone"></i>
                                        </span>
                                        <input asp-for="GCashNumber" class="form-control" placeholder="09171234567" maxlength="13" />
                                    </div>
                                    <span asp-validation-for="GCashNumber" class="text-danger small"></span>
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Format: 09XXXXXXXXX or +639XXXXXXXXX
                                    </small>
                                </div>

                                <!-- Account Name -->
                                <div class="mb-4">
                                    <label asp-for="AccountName" class="form-label fw-semibold">
                                        <i class="bi bi-person-fill text-primary me-1"></i> GCash Account Name *
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-person"></i>
                                        </span>
                                        <input asp-for="AccountName" class="form-control" placeholder="Juan Dela Cruz" />
                                    </div>
                                    <span asp-validation-for="AccountName" class="text-danger small"></span>
                                </div>

                                <!-- Payment Amount -->
                                <div class="mb-4">
                                    <label asp-for="Amount" class="form-label fw-semibold">
                                        <i class="bi bi-cash-stack text-success me-1"></i> Payment Amount *
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light fw-bold">&#8369;</span>
                                        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" max="@Model.RemainingBalance" />
                                    </div>
                                    <span asp-validation-for="Amount" class="text-danger small"></span>
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Maximum: &#8369;@Model.RemainingBalance.ToString("N2")
                                    </small>
                                </div>

                                <!-- Reference Number (Optional) -->
                                <div class="mb-4">
                                    <label asp-for="ReferenceNumber" class="form-label fw-semibold">
                                        <i class="bi bi-hash text-warning me-1"></i> Reference Number (Optional)
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-receipt"></i>
                                        </span>
                                        <input asp-for="ReferenceNumber" class="form-control" placeholder="Auto-generated if not provided" />
                                    </div>
                                    <span asp-validation-for="ReferenceNumber" class="text-danger small"></span>
                                    <small class="text-muted">
                                        Leave blank to auto-generate
                                    </small>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-grid gap-2 mt-4">
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="bi bi-check-circle-fill me-2"></i>
                                        Process GCash Payment
                                    </button>
                                    <a asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-2"></i> Cancel
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Summary Sidebar -->
                <div class="col-md-5">
                    <!-- Payment Summary -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-header bg-success text-white">
                            <h6 class="mb-0">
                                <i class="bi bi-receipt me-2"></i>
                                Payment Summary
                            </h6>
                        </div>
                        <div class="card-body">
                            <div class="mb-3 pb-3 border-bottom">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Total Amount:</span>
                                    <span class="fw-bold">&#8369;@Model.TotalAmount.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Already Paid:</span>
                                    <span class="text-success fw-bold">&#8369;@Model.AmountPaid.ToString("N2")</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="fw-bold">Remaining Balance:</span>
                                    <span class="text-danger fw-bold fs-5">&#8369;@Model.RemainingBalance.ToString("N2")</span>
                                </div>
                            </div>
                            
                            <div class="alert alert-warning border-0 mb-0">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <small>
                                    <strong>Note:</strong> Payment will be processed immediately upon submission.
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- GCash Info -->
                    <div class="card border-0 shadow-sm mb-3">
                        <div class="card-body">
                            <h6 class="fw-bold mb-3">
                                <i class="bi bi-phone text-primary me-2"></i>
                                About GCash Payment
                            </h6>
                            <ul class="small text-muted mb-0">
                                <li class="mb-2">
                                    <i class="bi bi-check-circle text-success me-1"></i>
                                    Fast and secure payment
                                </li>
                                <li class="mb-2">
                                    <i class="bi bi-check-circle text-success me-1"></i>
                                    Instant confirmation
                                </li>
                                <li class="mb-2">
                                    <i class="bi bi-check-circle text-success me-1"></i>
                                    24/7 available
                                </li>
                                <li>
                                    <i class="bi bi-check-circle text-success me-1"></i>
                                    No hidden fees
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- Security Badge -->
                    <div class="card border-0 shadow-sm bg-light">
                        <div class="card-body text-center">
                            <i class="bi bi-shield-check text-success display-4 mb-2"></i>
                            <h6 class="fw-bold mb-2">Secure Payment</h6>
                            <small class="text-muted">
                                Your payment information is protected with bank-level security
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Help Section -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-question-circle text-info me-2"></i>
                        Need Help?
                    </h6>
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="small fw-semibold">How to Pay via GCash:</h6>
                            <ol class="small text-muted">
                                <li>Enter your GCash mobile number</li>
                                <li>Enter your account name</li>
                                <li>Specify payment amount</li>
                                <li>Click "Process Payment"</li>
                            </ol>
                        </div>
                        <div class="col-md-6">
                            <h6 class="small fw-semibold">Important Notes:</h6>
                            <ul class="small text-muted">
                                <li>Ensure your GCash has sufficient balance</li>
                                <li>Double-check mobile number format</li>
                                <li>Save your reference number</li>
                                <li>Contact support if issues arise</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Format GCash number as user types
        document.getElementById('GCashNumber').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, ''); // Remove non-digits
            
            if (value.startsWith('63')) {
                value = '+' + value;
            } else if (value.startsWith('9') && value.length === 10) {
                value = '0' + value;
            }
            
            e.target.value = value;
        });

        // Update amount display with peso sign
        document.getElementById('Amount').addEventListener('input', function(e) {
            const amount = parseFloat(e.target.value) || 0;
            const maxAmount = parseFloat(e.target.max);
            
            if (amount > maxAmount) {
                e.target.value = maxAmount.toFixed(2);
            }
        });

        // Auto-capitalize account name
        document.getElementById('AccountName').addEventListener('input', function(e) {
            const words = e.target.value.split(' ');
            const capitalized = words.map(word => {
                return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
            }).join(' ');
            e.target.value = capitalized;
        });
    </script>
}

<style>
    .input-group-lg {
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .input-group-lg .form-control {
        font-size: 1.1rem;
    }
    
    .card {
        transition: all 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
</style>
