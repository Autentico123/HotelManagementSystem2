@model HotelManagementSystem2.Models.Booking

@{
    ViewData["Title"] = "Create Booking";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h2 class="mb-0"><i class="bi bi-calendar-plus"></i> Book Your Room</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <h5 class="mb-3 text-primary"><i class="bi bi-person-circle"></i> Guest Information</h5>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="GuestName" class="form-label fw-semibold">Full Name *</label>
                                <input asp-for="GuestName" class="form-control" placeholder="Juan Dela Cruz" required />
                                <span asp-validation-for="GuestName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="GuestEmail" class="form-label fw-semibold">Email Address *</label>
                                <input asp-for="GuestEmail" class="form-control" type="email" placeholder="juan@email.com" required />
                                <span asp-validation-for="GuestEmail" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="GuestPhone" class="form-label fw-semibold">Phone Number *</label>
                                <input asp-for="GuestPhone" class="form-control" placeholder="+639171234567" required />
                                <span asp-validation-for="GuestPhone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdentityDocument" class="form-label fw-semibold">ID Document Number</label>
                                <input asp-for="IdentityDocument" class="form-control" placeholder="Driver's License, Passport, etc." />
                                <span asp-validation-for="IdentityDocument" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="GuestAddress" class="form-label fw-semibold">Address</label>
                            <textarea asp-for="GuestAddress" class="form-control" rows="2" placeholder="Complete address"></textarea>
                            <span asp-validation-for="GuestAddress" class="text-danger"></span>
                        </div>

                        <hr class="my-4">
                        <h5 class="mb-3 text-primary"><i class="bi bi-calendar-week"></i> Booking Details</h5>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="RoomId" class="form-label fw-semibold">Select Room *</label>
                                <select asp-for="RoomId" class="form-select" asp-items="ViewBag.RoomId" required>
                                    <option value="">-- Select Room --</option>
                                </select>
                                <span asp-validation-for="RoomId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CheckInDate" class="form-label fw-semibold">Check-in Date *</label>
                                <input asp-for="CheckInDate" class="form-control" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="CheckInDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CheckOutDate" class="form-label fw-semibold">Check-out Date *</label>
                                <input asp-for="CheckOutDate" class="form-control" type="date" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                                <span asp-validation-for="CheckOutDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="NumberOfGuests" class="form-label fw-semibold">Number of Guests *</label>
                                <input asp-for="NumberOfGuests" class="form-control" type="number" min="1" value="1" required />
                                <span asp-validation-for="NumberOfGuests" class="text-danger"></span>
                            </div>
                            @if (User.IsInRole("Admin"))
                            {
                                <div class="col-md-4 mb-3">
                                    <label asp-for="AmountPaid" class="form-label fw-semibold">Amount Paid</label>
                                    <div class="input-group">
                                        <span class="input-group-text">&#8369;</span>
                                        <input asp-for="AmountPaid" class="form-control" type="number" step="0.01" value="0" />
                                    </div>
                                    <span asp-validation-for="AmountPaid" class="text-danger"></span>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label asp-for="PaymentMethod" class="form-label fw-semibold">Payment Method</label>
                                    <select asp-for="PaymentMethod" class="form-select">
                                        <option value="">Select Payment Method</option>
                                        <option value="Cash">Cash</option>
                                        <option value="Credit Card">Credit Card</option>
                                        <option value="Debit Card">Debit Card</option>
                                        <option value="Bank Transfer">Bank Transfer</option>
                                        <option value="GCash">GCash</option>
                                        <option value="PayMaya">PayMaya</option>
                                    </select>
                                    <span asp-validation-for="PaymentMethod" class="text-danger"></span>
                                </div>
                            }
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label fw-semibold">Special Requests (Optional)</label>
                            <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any special requests or notes..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        @if (!User.IsInRole("Admin"))
                        {
                            <div class="alert alert-info">
                                <i class="bi bi-info-circle"></i> <strong>Note:</strong> Your booking will be pending until approved by our admin team. We'll review your request shortly!
                            </div>
                        }

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg px-4">
                                <i class="bi bi-check-circle"></i> Submit Booking
                            </button>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-x-lg"></i> Cancel
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                    <i class="bi bi-arrow-left"></i> Back to Rooms
                                </a>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
