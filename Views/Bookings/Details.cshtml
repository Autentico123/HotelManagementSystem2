@model HotelManagementSystem2.Models.Booking

@{
    ViewData["Title"] = "Booking Details";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
}

@if (User.IsInRole("Admin"))
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold"><i class="bi bi-info-circle"></i> Booking Details</h1>
            <p class="text-muted">View and manage booking information</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to List
        </a>
    </div>
}
else
{
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h2 fw-bold"><i class="bi bi-info-circle"></i> Booking Details</h1>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> My Bookings
            </a>
        </div>
    </div>
}

<div class="row">
    <div class="col-lg-8 col-md-12">
        <div class="card mb-3 border-0 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-bookmark-check"></i> Booking Information</h5>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Booking Number:</strong><br>
                        <span class="fs-5 text-primary fw-bold">@Model.BookingNumber</span>
                    </div>
                    <div class="col-md-6">
                        <strong>Status:</strong><br>
                        @if (Model.Status == HotelManagementSystem2.Models.BookingStatus.Confirmed)
                        {
                            <span class="badge bg-success fs-6">Confirmed</span>
                        }
                        else if (Model.Status == HotelManagementSystem2.Models.BookingStatus.CheckedIn)
                        {
                            <span class="badge bg-primary fs-6">Checked In</span>
                        }
                        else if (Model.Status == HotelManagementSystem2.Models.BookingStatus.CheckedOut)
                        {
                            <span class="badge bg-secondary fs-6">Checked Out</span>
                        }
                        else if (Model.Status == HotelManagementSystem2.Models.BookingStatus.Cancelled)
                        {
                            <span class="badge bg-danger fs-6">Cancelled</span>
                        }
                        else
                        {
                            <span class="badge bg-warning fs-6">Pending</span>
                        }
                    </div>
                </div>

                <hr>

                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-person"></i> Guest Information</h6>
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <strong>Name:</strong> @Model.GuestName
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Email:</strong> <a href="mailto:@Model.GuestEmail">@Model.GuestEmail</a>
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Phone:</strong> <a href="tel:@Model.GuestPhone">@Model.GuestPhone</a>
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>ID Document:</strong> @Model.IdentityDocument
                    </div>
                    <div class="col-12 mb-2">
                        <strong>Address:</strong> @Model.GuestAddress
                    </div>
                </div>

                <hr>

                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-door-open"></i> Room & Stay Details</h6>
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <strong>Room Number:</strong> <span class="badge bg-info">@Model.Room.RoomNumber</span>
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Room Type:</strong> @Model.Room.RoomType
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Check-in:</strong> @Model.CheckInDate.ToString("MMMM dd, yyyy")
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Check-out:</strong> @Model.CheckOutDate.ToString("MMMM dd, yyyy")
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Number of Guests:</strong> @Model.NumberOfGuests
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Nights:</strong> @((Model.CheckOutDate - Model.CheckInDate).Days)
                    </div>
                </div>

                <hr>

                <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-cash-coin"></i> Payment Information</h6>
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <strong>Total Amount:</strong><br>
                        <span class="text-success fw-bold fs-5">&#8369;@Model.TotalAmount.ToString("N2")</span>
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Amount Paid:</strong><br>
                        <span class="fw-bold fs-5">&#8369;@Model.AmountPaid.ToString("N2")</span>
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Balance:</strong><br>
                        <span class="@(Model.Balance > 0 ? "text-danger" : "text-success") fw-bold fs-5">&#8369;@Model.Balance.ToString("N2")</span>
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Payment Method:</strong><br>
                        @if (!string.IsNullOrEmpty(Model.PaymentMethod))
                        {
                            <span class="badge bg-secondary">@Model.PaymentMethod</span>
                        }
                        else
                        {
                            <span class="text-muted">Not specified</span>
                        }
                    </div>
                </div>

                @if (Model.PaymentMethod == "GCash" && !string.IsNullOrEmpty(Model.GCashNumber))
                {
                    <hr>
                    <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-phone-fill"></i> GCash Payment Details</h6>
                    <div class="row">
                        <div class="col-md-6 mb-2">
                            <strong>GCash Number:</strong><br>
                            <span class="text-monospace">@Model.GCashNumber</span>
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Account Name:</strong><br>
                            @Model.GCashAccountName
                        </div>
                        <div class="col-md-6 mb-2">
                            <strong>Reference Number:</strong><br>
                            <span class="badge bg-info text-dark">@Model.GCashReferenceNumber</span>
                        </div>
                        @if (Model.GCashPaymentDate != null)
                        {
                            <div class="col-md-6 mb-2">
                                <strong>Payment Date:</strong><br>
                                @Model.GCashPaymentDate.Value.ToString("MMMM dd, yyyy hh:mm tt")
                            </div>
                        }
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <hr>
                    <h6 class="fw-bold mb-2 text-primary"><i class="bi bi-note-text"></i> Notes</h6>
                    <div class="alert alert-info">
                        @Model.Notes
                    </div>
                }

                <hr>

                <div class="row">
                    <div class="col-md-6 mb-2">
                        <strong>Created:</strong> @Model.CreatedAt.ToString("MMMM dd, yyyy hh:mm tt")
                    </div>
                    <div class="col-md-6 mb-2">
                        <strong>Created By:</strong> @Model.CreatedBy
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white">
                <h6 class="mb-0 fw-bold"><i class="bi bi-lightning"></i> Quick Actions</h6>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2">
                    @if (User.IsInRole("Admin"))
                    {
                        @if (Model.Status == HotelManagementSystem2.Models.BookingStatus.Confirmed || Model.Status == HotelManagementSystem2.Models.BookingStatus.Pending)
                        {
                            <form asp-action="CheckIn" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-success" onclick="return confirm('Check in this guest?')">
                                    <i class="bi bi-box-arrow-in-right"></i> Check In
                                </button>
                            </form>
                        }
                        
                        @if (Model.Status == HotelManagementSystem2.Models.BookingStatus.CheckedIn)
                        {
                            <form asp-action="CheckOut" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-warning" onclick="return confirm('Check out this guest?')">
                                    <i class="bi bi-box-arrow-right"></i> Check Out
                                </button>
                            </form>
                        }
                        
                        @if (Model.Status != HotelManagementSystem2.Models.BookingStatus.Cancelled && Model.Status != HotelManagementSystem2.Models.BookingStatus.CheckedOut)
                        {
                            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Cancel this booking?')">
                                    <i class="bi bi-x-circle"></i> Cancel Booking
                                </button>
                            </form>
                        }

                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit Booking
                        </a>
                        
                        @if (Model.Balance > 0)
                        {
                            <a asp-controller="GCashPayments" asp-action="Pay" asp-route-id="@Model.Id" class="btn btn-info">
                                <i class="bi bi-phone-fill"></i> Pay with GCash
                            </a>
                        }
                    }
                    else
                    {
                        @if (Model.Status == HotelManagementSystem2.Models.BookingStatus.Pending || Model.Status == HotelManagementSystem2.Models.BookingStatus.Confirmed)
                        {
                            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to cancel this booking?')">
                                    <i class="bi bi-x-circle"></i> Cancel Booking
                                </button>
                            </form>
                        }
                        
                        @if (Model.Balance > 0 && Model.Status != HotelManagementSystem2.Models.BookingStatus.Cancelled)
                        {
                            <a asp-controller="GCashPayments" asp-action="Pay" asp-route-id="@Model.Id" class="btn btn-success btn-lg">
                                <i class="bi bi-phone-fill"></i> Pay with GCash
                            </a>
                        }
                    }

                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 col-md-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Booking Summary</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <small class="text-muted">Room</small>
                    <p class="mb-0 fw-bold">Room @Model.Room.RoomNumber - @Model.Room.RoomType</p>
                </div>
                <div class="mb-3">
                    <small class="text-muted">Duration</small>
                    <p class="mb-0 fw-bold">@((Model.CheckOutDate - Model.CheckInDate).Days) Night(s)</p>
                </div>
                <div class="mb-3">
                    <small class="text-muted">Dates</small>
                    <p class="mb-0">@Model.CheckInDate.ToString("MMM dd") - @Model.CheckOutDate.ToString("MMM dd, yyyy")</p>
                </div>
                <hr>
                <div class="mb-2 d-flex justify-content-between">
                    <span>Total:</span>
                    <span class="fw-bold">&#8369;@Model.TotalAmount.ToString("N2")</span>
                </div>
                <div class="mb-2 d-flex justify-content-between">
                    <span>Paid:</span>
                    <span class="fw-bold text-success">&#8369;@Model.AmountPaid.ToString("N2")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="fw-bold">Balance:</span>
                    <span class="fw-bold @(Model.Balance > 0 ? "text-danger" : "text-success")">&#8369;@Model.Balance.ToString("N2")</span>
                </div>
                
                @if (Model.Balance > 0 && Model.Status != HotelManagementSystem2.Models.BookingStatus.Cancelled)
                {
                    <div class="mt-3 d-grid">
                        <a asp-controller="GCashPayments" asp-action="Pay" asp-route-id="@Model.Id" class="btn btn-success">
                            <i class="bi bi-phone-fill me-2"></i>Pay Now via GCash
                        </a>
                    </div>
                }

            </div>
        </div>

        @if (Model.Status == HotelManagementSystem2.Models.BookingStatus.Pending)
        {
            <div class="card border-warning mt-3">
                <div class="card-body">
                    <h6 class="card-title text-warning"><i class="bi bi-exclamation-triangle"></i> Pending Approval</h6>
                    <p class="card-text small mb-0">This booking is awaiting admin approval.</p>
                </div>
            </div>
        }
        else if (Model.Status == HotelManagementSystem2.Models.BookingStatus.Confirmed)
        {
            <div class="card border-success mt-3">
                <div class="card-body">
                    <h6 class="card-title text-success"><i class="bi bi-check-circle"></i> Confirmed</h6>
                    <p class="card-text small mb-0">This booking has been confirmed.</p>
                </div>
            </div>
        }
        else if (Model.Status == HotelManagementSystem2.Models.BookingStatus.CheckedIn)
        {
            <div class="card border-primary mt-3">
                <div class="card-body">
                    <h6 class="card-title text-primary"><i class="bi bi-door-open"></i> Checked In</h6>
                    <p class="card-text small mb-0">Guest is currently checked in.</p>
                </div>
            </div>
        }
    </div>
</div>
