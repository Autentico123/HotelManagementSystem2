@model IEnumerable<HotelManagementSystem2.Models.Booking>

@{
    ViewData["Title"] = User.IsInRole("Admin") ? "Bookings Management" : "My Bookings";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 fw-bold">
                <i class="bi bi-calendar-check"></i> 
                @if (User.IsInRole("Admin"))
                {
                    <text>Bookings Management</text>
                }
                else
                {
                    <text>My Bookings</text>
                }
            </h1>
            @if (!User.IsInRole("Admin"))
            {
                <p class="text-muted">View and manage your hotel reservations</p>
            }
            else
            {
                <p class="text-muted">Manage all hotel bookings</p>
            }
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> New Booking
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Booking #</th>
                                <th>Guest Name</th>
                                <th>Room</th>
                                <th>Check-in</th>
                                <th>Check-out</th>
                                <th>Guests</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="fw-bold">@item.BookingNumber</td>
                                    <td>@item.GuestName</td>
                                    <td>Room @item.Room.RoomNumber</td>
                                    <td>@item.CheckInDate.ToString("MMM dd, yyyy")</td>
                                    <td>@item.CheckOutDate.ToString("MMM dd, yyyy")</td>
                                    <td>@item.NumberOfGuests</td>
                                    <td class="fw-bold">&#8369;@item.TotalAmount.ToString("N2")</td>
                                    <td>
                                        @if (item.Status == HotelManagementSystem2.Models.BookingStatus.Confirmed)
                                        {
                                            <span class="badge bg-success">Confirmed</span>
                                        }
                                        else if (item.Status == HotelManagementSystem2.Models.BookingStatus.CheckedIn)
                                        {
                                            <span class="badge bg-primary">Checked In</span>
                                        }
                                        else if (item.Status == HotelManagementSystem2.Models.BookingStatus.CheckedOut)
                                        {
                                            <span class="badge bg-secondary">Checked Out</span>
                                        }
                                        else if (item.Status == HotelManagementSystem2.Models.BookingStatus.Cancelled)
                                        {
                                            <span class="badge bg-danger">Cancelled</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-calendar-x" style="font-size: 4rem; color: #ccc;"></i>
                <h4 class="mt-3">No Bookings Yet</h4>
                <p class="text-muted">You haven't made any bookings yet. Browse our available rooms and book your stay!</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
                    <i class="bi bi-search"></i> Browse Rooms
                </a>
            </div>
        </div>
    }
</div>
