@model HotelManagementSystem2.Models.ViewModels.GCashPaymentWithVerificationViewModel

@{
    ViewData["Title"] = "Pay with GCash";
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Header -->
            <div class="mb-4">
                <a asp-controller="Bookings" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary mb-3">
                    <i class="bi bi-arrow-left"></i> Back to Booking
                </a>
                <h2 class="fw-bold">
                    <i class="bi bi-phone text-primary"></i> Pay with GCash
                </h2>
                <p class="text-muted">Send payment to admin's GCash and upload proof</p>
            </div>

            <div class="row g-4">
                <!-- Left Column - Payment Instructions -->
                <div class="col-md-5">
                    <!-- Admin GCash Details Card -->
                    <div class="card border-0 shadow-lg mb-4">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-send me-2"></i>
                                Send Payment To
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="text-center mb-3">
                                @if (!string.IsNullOrEmpty(Model.AdminGCashQRCode))
                                {
                                    <img src="@Model.AdminGCashQRCode" alt="GCash QR Code" class="img-fluid mb-3" style="max-width: 250px;" />
                                    <p class="small text-muted">Scan QR Code to pay</p>
                                }
                                else
                                {
                                    <div class="bg-light p-4 rounded">
                                        <i class="bi bi-qr-code display-1 text-muted"></i>
                                        <p class="small text-muted mt-2">QR Code not available</p>
                                    </div>
                                }
                            </div>

                            <hr>

                            <div class="mb-3">
                                <label class="fw-bold text-muted small">GCash Number:</label>
                                <div class="d-flex align-items-center justify-content-between bg-light p-3 rounded">
                                    <span class="fs-4 fw-bold text-primary font-monospace">@Model.AdminGCashNumber</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="copyToClipboard('@Model.AdminGCashNumber')">
                                        <i class="bi bi-clipboard"></i> Copy
                                    </button>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="fw-bold text-muted small">Account Name:</label>
                                <div class="bg-light p-3 rounded">
                                    <span class="fw-bold">@Model.AdminGCashAccountName</span>
                                </div>
                            </div>

                            <div class="alert alert-warning border-0 mb-0">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Important:</strong> Make sure to send to the correct GCash number above!
                            </div>
                        </div>
                    </div>

                    <!-- Payment Instructions -->
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-info text-white">
                            <h6 class="mb-0">
                                <i class="bi bi-info-circle me-2"></i>
                                How to Pay
                            </h6>
                        </div>
                        <div class="card-body">
                            <ol class="small mb-0">
                                <li class="mb-2">Open your GCash app</li>
                                <li class="mb-2">Send money to: <strong>@Model.AdminGCashNumber</strong></li>
                                <li class="mb-2">Take a screenshot of the transaction</li>
                                <li class="mb-2">Fill in the form and upload screenshot</li>
                                <li class="mb-2">Wait for admin verification (usually within 24 hours)</li>
                            </ol>
                        </div>
                    </div>
                </div>

                <!-- Right Column - Payment Form -->
                <div class="col-md-7">
                    <!-- Booking Info -->
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-6">
                                    <small class="text-muted">Booking Number</small>
                                    <p class="fw-bold mb-2">@Model.BookingNumber</p>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Guest Name</small>
                                    <p class="fw-bold mb-2">@Model.GuestName</p>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted">Total Amount</small>
                                    <p class="fw-bold text-primary mb-0">?@Model.TotalAmount.ToString("N2")</p>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted">Paid</small>
                                    <p class="fw-bold text-success mb-0">?@Model.AmountPaid.ToString("N2")</p>
                                </div>
                                <div class="col-4">
                                    <small class="text-muted">Balance</small>
                                    <p class="fw-bold text-danger mb-0">?@Model.RemainingBalance.ToString("N2")</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Form -->
                    <div class="card border-0 shadow-lg">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">
                                <i class="bi bi-upload me-2"></i>
                                Submit Payment Proof
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <form asp-action="Pay" method="post" enctype="multipart/form-data">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                                
                                <input asp-for="BookingId" type="hidden" />

                                <!-- Your GCash Number -->
                                <div class="mb-4">
                                    <label asp-for="SenderGCashNumber" class="form-label fw-semibold">
                                        <i class="bi bi-phone-fill text-primary me-1"></i> Your GCash Number *
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-phone"></i>
                                        </span>
                                        <input asp-for="SenderGCashNumber" class="form-control" placeholder="09171234567" maxlength="13" />
                                    </div>
                                    <span asp-validation-for="SenderGCashNumber" class="text-danger small"></span>
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        The number you used to send payment
                                    </small>
                                </div>

                                <!-- Your Account Name -->
                                <div class="mb-4">
                                    <label asp-for="SenderAccountName" class="form-label fw-semibold">
                                        <i class="bi bi-person-fill text-primary me-1"></i> Your GCash Account Name *
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-person"></i>
                                        </span>
                                        <input asp-for="SenderAccountName" class="form-control" placeholder="Juan Dela Cruz" />
                                    </div>
                                    <span asp-validation-for="SenderAccountName" class="text-danger small"></span>
                                </div>

                                <!-- Payment Amount -->
                                <div class="mb-4">
                                    <label asp-for="Amount" class="form-label fw-semibold">
                                        <i class="bi bi-cash-stack text-success me-1"></i> Amount Sent *
                                    </label>
                                    <div class="input-group input-group-lg">
                                        <span class="input-group-text bg-light fw-bold">?</span>
                                        <input asp-for="Amount" class="form-control" type="number" step="0.01" min="0.01" max="@Model.RemainingBalance" />
                                    </div>
                                    <span asp-validation-for="Amount" class="text-danger small"></span>
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Maximum: ?@Model.RemainingBalance.ToString("N2")
                                    </small>
                                </div>

                                <!-- Reference Number -->
                                <div class="mb-4">
                                    <label asp-for="ReferenceNumber" class="form-label fw-semibold">
                                        <i class="bi bi-hash text-warning me-1"></i> GCash Reference Number (Optional)
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-receipt"></i>
                                        </span>
                                        <input asp-for="ReferenceNumber" class="form-control" placeholder="e.g., 1234567890" />
                                    </div>
                                    <span asp-validation-for="ReferenceNumber" class="text-danger small"></span>
                                    <small class="text-muted">
                                        Found in your GCash transaction details
                                    </small>
                                </div>

                                <!-- Upload Proof -->
                                <div class="mb-4">
                                    <label asp-for="ProofImage" class="form-label fw-semibold">
                                        <i class="bi bi-image text-info me-1"></i> Upload Payment Screenshot *
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light">
                                            <i class="bi bi-upload"></i>
                                        </span>
                                        <input asp-for="ProofImage" class="form-control" type="file" accept="image/*" required />
                                    </div>
                                    <span asp-validation-for="ProofImage" class="text-danger small"></span>
                                    <small class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        Accepted: JPG, PNG, JPEG (Max 5MB)
                                    </small>
                                </div>

                                <!-- Notes -->
                                <div class="mb-4">
                                    <label asp-for="Notes" class="form-label fw-semibold">
                                        <i class="bi bi-sticky text-secondary me-1"></i> Additional Notes (Optional)
                                    </label>
                                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any additional information..."></textarea>
                                    <span asp-validation-for="Notes" class="text-danger small"></span>
                                </div>

                                <!-- Important Notice -->
                                <div class="alert alert-info border-0 mb-4">
                                    <h6 class="alert-heading">
                                        <i class="bi bi-info-circle me-2"></i>Important Notice
                                    </h6>
                                    <ul class="small mb-0">
                                        <li>Your payment will be <strong>pending verification</strong> by admin</li>
                                        <li>Verification usually takes <strong>24 hours</strong></li>
                                        <li>You'll be notified once verified</li>
                                        <li>Make sure all information is correct</li>
                                    </ul>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        <i class="bi bi-check-circle-fill me-2"></i>
                                        Submit Payment Proof
                                    </button>
                                    <a asp-controller="Bookings" asp-action="Details" asp-route-id="@Model.BookingId" class="btn btn-outline-secondary">
                                        <i class="bi bi-x-circle me-2"></i> Cancel
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Copy to clipboard function
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(function() {
                alert('GCash number copied to clipboard!');
            }, function() {
                alert('Failed to copy. Please copy manually.');
            });
        }

        // Format GCash number
        document.getElementById('SenderGCashNumber').addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            
            if (value.startsWith('63')) {
                value = '+' + value;
            } else if (value.startsWith('9') && value.length === 10) {
                value = '0' + value;
            }
            
            e.target.value = value;
        });

        // Validate file size
        document.querySelector('input[type="file"]').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file && file.size > 5 * 1024 * 1024) { // 5MB
                alert('File size must not exceed 5MB');
                e.target.value = '';
            }
        });

        // Auto-capitalize account name
        document.getElementById('SenderAccountName').addEventListener('input', function(e) {
            const words = e.target.value.split(' ');
            const capitalized = words.map(word => {
                return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
            }).join(' ');
            e.target.value = capitalized;
        });
    </script>
}

<style>
    .font-monospace {
        font-family: 'Courier New', monospace;
    }
    
    .input-group-lg {
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    
    .card {
        transition: all 0.3s ease;
    }
    
    .card:hover {
        transform: translateY(-2px);
    }
</style>
