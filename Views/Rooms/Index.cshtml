@model IEnumerable<HotelManagementSystem2.Models.Room>

@{
    ViewData["Title"] = "Rooms Management";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 fw-bold"><i class="bi bi-door-open"></i> Rooms Management</h1>
        <p class="text-muted">Manage all hotel rooms</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-admin">
        <i class="bi bi-plus-lg"></i> Add New Room
    </a>
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm room-card">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="room-image" alt="Room @item.RoomNumber" />
                }
                else
                {
                    <div class="room-image bg-secondary d-flex align-items-center justify-content-center">
                        <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                    </div>
                }
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <h4 class="card-title fw-bold mb-0">Room @item.RoomNumber</h4>
                        @if (item.Status == HotelManagementSystem2.Models.RoomStatus.Available)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else if (item.Status == HotelManagementSystem2.Models.RoomStatus.Occupied)
                        {
                            <span class="badge bg-danger">Occupied</span>
                        }
                        else if (item.Status == HotelManagementSystem2.Models.RoomStatus.Reserved)
                        {
                            <span class="badge bg-warning">Reserved</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Maintenance</span>
                        }
                    </div>
                    
                    <div class="mb-3">
                        <span class="badge bg-primary me-2">@item.RoomType</span>
                        <span class="badge bg-info">
                            <i class="bi bi-people"></i> @item.Capacity
                        </span>
                    </div>

                    <p class="card-text text-muted small">@item.Description</p>
                    
                    <h5 class="text-primary fw-bold mb-3">&#8369;@item.PricePerNight.ToString("N2") <small class="text-muted fs-6">/night</small></h5>
                    
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
