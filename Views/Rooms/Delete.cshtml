@model HotelManagementSystem2.Models.Room

@{
    ViewData["Title"] = "Delete Room";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 fw-bold text-danger"><i class="bi bi-trash"></i> Delete Room</h1>
        <p class="text-muted">Are you sure you want to delete this room?</p>
    </div>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle"></i> Confirm Deletion</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Warning!</strong> This will perform a soft delete. The room will be marked as inactive and won't be visible in the system.
                </div>

                <h6 class="fw-bold mb-3">Room Details:</h6>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Room Number:</strong>
                        <p class="text-muted">@Model.RoomNumber</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Room Type:</strong>
                        <p class="text-muted">@Model.RoomType</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Capacity:</strong>
                        <p class="text-muted">@Model.Capacity Guest(s)</p>
                    </div>
                    <div class="col-md-6">
                        <strong>Price per Night:</strong>
                        <p class="text-muted text-primary fw-bold">?@Model.PricePerNight.ToString("N2")</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <strong>Description:</strong>
                        <p class="text-muted">@Model.Description</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <strong>Amenities:</strong>
                        <p class="text-muted">@Model.Amenities</p>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Status:</strong>
                        <p>
                            @if (Model.Status == HotelManagementSystem2.Models.RoomStatus.Available)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else if (Model.Status == HotelManagementSystem2.Models.RoomStatus.Occupied)
                            {
                                <span class="badge bg-danger">Occupied</span>
                            }
                            else if (Model.Status == HotelManagementSystem2.Models.RoomStatus.Reserved)
                            {
                                <span class="badge bg-warning">Reserved</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Maintenance</span>
                            }
                        </p>
                    </div>
                </div>

                <hr class="my-4">

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger" onclick="return confirm('Are you absolutely sure you want to delete this room?')">
                            <i class="bi bi-trash"></i> Yes, Delete Room
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card border-warning">
            <div class="card-header bg-warning">
                <h6 class="mb-0"><i class="bi bi-info-circle"></i> Important Information</h6>
            </div>
            <div class="card-body">
                <h6 class="fw-bold">What happens when you delete?</h6>
                <ul class="small">
                    <li>Room will be marked as inactive</li>
                    <li>Won't appear in room listings</li>
                    <li>Can't be booked anymore</li>
                    <li>Existing bookings remain valid</li>
                    <li>Can be restored by admin if needed</li>
                </ul>

                <hr>

                <h6 class="fw-bold text-danger">Before Deleting:</h6>
                <ul class="small">
                    <li>Check for active bookings</li>
                    <li>Notify affected guests if needed</li>
                    <li>Consider setting to maintenance instead</li>
                </ul>
            </div>
        </div>
    </div>
</div>
