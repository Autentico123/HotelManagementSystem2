@model HotelManagementSystem2.Models.Room

@{
    ViewData["Title"] = "Edit Room";
    Layout = "_AdminLayout";
}

<h1><i class="bi bi-pencil"></i> Edit Room</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="RoomNumber" class="form-label"></label>
                            <input asp-for="RoomNumber" class="form-control" />
                            <span asp-validation-for="RoomNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="RoomType" class="form-label"></label>
                            <select asp-for="RoomType" class="form-select" asp-items="Html.GetEnumSelectList<HotelManagementSystem2.Models.RoomType>()"></select>
                            <span asp-validation-for="RoomType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PricePerNight" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">&#8369;</span>
                                <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" />
                            </div>
                            <span asp-validation-for="PricePerNight" class="text-danger"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="Capacity" class="form-label"></label>
                            <input asp-for="Capacity" class="form-control" type="number" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Amenities" class="form-label"></label>
                        <textarea asp-for="Amenities" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="Amenities" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label">Image URL</label>
                        <input asp-for="ImageUrl" class="form-control" type="url" placeholder="https://images.unsplash.com/..." />
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>
                        <small class="text-muted">Enter an Unsplash or image URL</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<HotelManagementSystem2.Models.RoomStatus>()"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label"></label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save"></i> Update Room
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-lg"></i> Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
