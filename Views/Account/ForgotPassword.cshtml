@model HotelManagementSystem2.Models.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-primary text-white text-center py-4">
                    <i class="bi bi-key display-4 mb-3"></i>
                    <h3 class="mb-0 fw-bold">Forgot Password?</h3>
                    <p class="mb-0 small">No worries, we'll send you reset instructions</p>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info border-0 mb-4" role="alert">
                        <i class="bi bi-info-circle me-2"></i>
                        Enter your email address and we'll help you reset your password.
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="bi bi-envelope me-1"></i> Email Address
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light">
                                    <i class="bi bi-at"></i>
                                </span>
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="you@example.com" autofocus />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mb-4">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-send me-2"></i> Send Reset Link
                            </button>
                        </div>
                    </form>

                    <hr class="my-4">

                    <div class="text-center">
                        <p class="text-muted mb-2">
                            <i class="bi bi-arrow-left-circle me-1"></i>
                            Remember your password?
                        </p>
                        <a asp-action="Login" class="btn btn-outline-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Back to Login
                        </a>
                    </div>
                </div>
            </div>

            <!-- Help Card -->
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-question-circle text-primary me-2"></i> Need Help?
                    </h6>
                    <ul class="small text-muted mb-0">
                        <li class="mb-2">Make sure to use the email you registered with</li>
                        <li class="mb-2">Check your spam folder if you don't receive the email</li>
                        <li class="mb-2">The reset link will expire in 24 hours</li>
                        <li>Contact support if you continue having issues</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
