@{
    ViewData["Title"] = "Password Reset Successful";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-success text-white text-center py-4">
                    <i class="bi bi-check-circle-fill display-3 mb-3"></i>
                    <h3 class="mb-0 fw-bold">Password Reset Successful!</h3>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="alert alert-success border-0 mb-4" role="alert">
                        <i class="bi bi-shield-check display-4 mb-3 d-block text-success"></i>
                        <h5 class="fw-bold">Your password has been changed</h5>
                        <p class="mb-0">You can now log in with your new password.</p>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold mb-3">What's Next?</h6>
                        <p class="text-muted">Click the button below to log in to your account with your new password.</p>
                    </div>

                    <div class="d-grid gap-2 mb-4">
                        <a asp-action="Login" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Continue to Login
                        </a>
                    </div>

                    <hr class="my-3">

                    <div class="d-grid gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-house me-2"></i> Go to Home
                        </a>
                    </div>
                </div>
            </div>

            <!-- Security Tips Card -->
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-shield-lock text-primary me-2"></i> Security Tips
                    </h6>
                    <ul class="small text-muted mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-1"></i>
                            Never share your password with anyone
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-1"></i>
                            Use a unique password for each account
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle text-success me-1"></i>
                            Consider using a password manager
                        </li>
                        <li>
                            <i class="bi bi-check-circle text-success me-1"></i>
                            Change your password regularly
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Alert Card -->
            <div class="alert alert-warning border-0 shadow-sm mt-3" role="alert">
                <div class="d-flex align-items-start">
                    <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                    <div>
                        <strong>Important!</strong>
                        <p class="mb-0 small">If you didn't request this password change, please contact support immediately.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
