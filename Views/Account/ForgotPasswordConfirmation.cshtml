@{
    ViewData["Title"] = "Password Reset Email Sent";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg">
                <div class="card-header bg-success text-white text-center py-4">
                    <i class="bi bi-check-circle display-3 mb-3"></i>
                    <h3 class="mb-0 fw-bold">Check Your Email</h3>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="alert alert-success border-0 mb-4" role="alert">
                        <i class="bi bi-envelope-check display-4 mb-3 d-block"></i>
                        <h5 class="fw-bold">Password Reset Link Sent!</h5>
                        <p class="mb-0">If an account exists with the email you provided, you'll receive password reset instructions.</p>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold mb-3">What's Next?</h6>
                        <div class="text-start">
                            <div class="d-flex align-items-start mb-3">
                                <div class="flex-shrink-0">
                                    <span class="badge bg-primary rounded-circle" style="width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;">1</span>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <p class="mb-0">Check your email inbox</p>
                                </div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <div class="flex-shrink-0">
                                    <span class="badge bg-primary rounded-circle" style="width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;">2</span>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <p class="mb-0">Click the reset password link</p>
                                </div>
                            </div>
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <span class="badge bg-primary rounded-circle" style="width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;">3</span>
                                </div>
                                <div class="flex-grow-1 ms-3">
                                    <p class="mb-0">Create a new password</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (TempData["ResetToken"] != null)
                    {
                        <div class="alert alert-warning border-0 mb-4" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Development Mode:</strong> Since email is not configured, click below to continue.
                            <div class="d-grid gap-2 mt-3">
                                <a asp-action="ResetPassword" class="btn btn-warning">
                                    <i class="bi bi-key me-2"></i> Continue to Reset Password
                                </a>
                            </div>
                        </div>
                    }

                    <hr class="my-4">

                    <div class="d-grid gap-2">
                        <a asp-action="Login" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Back to Login
                        </a>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-house me-2"></i> Go to Home
                        </a>
                    </div>
                </div>
            </div>

            <!-- Troubleshooting Card -->
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-info-circle text-info me-2"></i> Didn't Receive the Email?
                    </h6>
                    <ul class="small text-muted mb-3">
                        <li class="mb-2">Check your spam or junk folder</li>
                        <li class="mb-2">Make sure you entered the correct email</li>
                        <li class="mb-2">Wait a few minutes and check again</li>
                    </ul>
                    <a asp-action="ForgotPassword" class="btn btn-sm btn-outline-primary w-100">
                        <i class="bi bi-arrow-clockwise me-1"></i> Resend Email
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
